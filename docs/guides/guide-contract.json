{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Ogeemo Guide Contract",
    "type": "object",
    "required": [
        "guideId",
        "title",
        "module",
        "intent",
        "targetAudience",
        "description",
        "prerequisites",
        "steps",
        "validations",
        "commonErrors",
        "recovery",
        "faq",
        "keywords",
        "version",
        "lastVerifiedAt"
    ],
    "properties": {
        "guideId": {
            "type": "string",
            "minLength": 1
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "module": {
            "type": "string",
            "minLength": 1
        },
        "intent": {
            "type": "string",
            "minLength": 1
        },
        "targetAudience": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "prerequisites": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "steps": {
            "type": "array",
            "minItems": 3,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "validations": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "commonErrors": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "recovery": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "faq": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "question",
                    "answer"
                ],
                "properties": {
                    "question": {
                        "type": "string",
                        "minLength": 1
                    },
                    "answer": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "additionalProperties": false
            }
        },
        "keywords": {
            "type": "array",
            "minItems": 3,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "version": {
            "type": "string",
            "minLength": 1
        },
        "lastVerifiedAt": {
            "type": "string",
            "minLength": 1
        },
        "source": {
            "type": "object",
            "properties": {
                "targetUrl": {
                    "type": "string"
                },
                "finalUrl": {
                    "type": "string"
                },
                "workflowInstruction": {
                    "type": "string"
                },
                "allowedHosts": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "finalUiContext": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "actionTrace": {
            "type": "string"
        }
    },
    "additionalProperties": true
}