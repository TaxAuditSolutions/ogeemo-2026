rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function profileOrgId() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId
        : null;
    }

    function profileAccessLevel() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accessLevel
        : null;
    }

    function currentOrgId() {
      return isSignedIn() && request.auth.token.orgId != null
        ? request.auth.token.orgId
        : profileOrgId();
    }

    // 1. Helper Functions for decoding Auth Token Claims
    function isRightTenant(docOrgId) {
      return isSignedIn() && currentOrgId() == docOrgId;
    }

    function hasAccessLevel(level) {
      return isSignedIn() && (
        request.auth.token.accessLevel == level ||
        profileAccessLevel() == level
      );
    }

    // Role helpers (super_admin only ever applies to master-tenant users)
    function isSuperAdmin() {
      return hasAccessLevel('super_admin');
    }

    function isMasterTenant() {
      return isSignedIn() && request.auth.token.isMasterTenant == true;
    }

    function isOrgAdmin() {
      return hasAccessLevel('org_admin') || isSuperAdmin();
    }

    function isEditor() {
      return hasAccessLevel('editor') || isOrgAdmin();
    }

    function isViewer() {
      return hasAccessLevel('viewer') || isEditor();
    }

    // Strict target-role matrix helpers: an actor may only manage users with a strictly lower role.
    function roleWeight(level) {
      return level == 'super_admin' ? 4 :
             level == 'org_admin' ? 3 :
             level == 'editor' ? 2 :
             level == 'viewer' ? 1 : 0;
    }

    function actingRoleWeight() {
      return roleWeight(request.auth.token.accessLevel != null ? request.auth.token.accessLevel : profileAccessLevel());
    }

    function canManageTargetRole(targetLevel) {
      return isSuperAdmin() || actingRoleWeight() > roleWeight(targetLevel);
    }

    // 2. Data Protection & Role Enforcement functions
    function canReadOrgDoc() {
      return isViewer() && isRightTenant(resource.data.orgId);
    }
    
    function canCreateOrgDoc() {
      return isEditor() && isRightTenant(request.resource.data.orgId);
    }
    
    function canUpdateOrgDoc() {
      return isEditor() && isRightTenant(resource.data.orgId) && isRightTenant(request.resource.data.orgId);
    }

    function canDeleteOrgDoc() {
      return isEditor() && isRightTenant(resource.data.orgId);
    }

    // ---------------------------------------------------------
    // Core Tenant Configuration Collections
    // ---------------------------------------------------------
    
    match /organizations/{orgId} {
      // Master-tenant super admins manage tenant lifecycle (create/list companies) but this is the
      // ONLY collection where they get a cross-tenant exception -- never for business data below.
      allow read: if isRightTenant(orgId) || (isMasterTenant() && isSuperAdmin());
      allow write: if (isRightTenant(orgId) && isOrgAdmin()) || (isMasterTenant() && isSuperAdmin());
    }

    match /users/{userId} {
      // Users can read their own profile, or any profile within their org
      allow read: if isSignedIn() && (request.auth.uid == userId || canReadOrgDoc());
      allow create: if isOrgAdmin() && isRightTenant(request.resource.data.orgId) && canManageTargetRole(request.resource.data.accessLevel);
      // Self-updates may never change accessLevel (prevents client-side role self-escalation).
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.accessLevel == resource.data.accessLevel) ||
        (isOrgAdmin() && isRightTenant(resource.data.orgId) && canManageTargetRole(resource.data.accessLevel) && canManageTargetRole(request.resource.data.accessLevel))
      );
      allow delete: if isOrgAdmin() && isRightTenant(resource.data.orgId) && canManageTargetRole(resource.data.accessLevel);
    }

    // ---------------------------------------------------------
    // Shared Business Collections
    // ---------------------------------------------------------
    
    match /contactFolders/{folderId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /contacts/{contactId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /clientAccounts/{accountId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /internalAccounts/{accountId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /quotes/{quoteId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /quoteLineItems/{itemId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /invoices/{invoiceId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /invoiceLineItems/{itemId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /serviceItems/{itemId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /taxTypes/{typeId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /incomeTransactions/{transactionId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /expenseTransactions/{transactionId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /payableBills/{billId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /pettyCashTransactions/{transactionId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    
    match /payrollRuns/{runId} { 
      allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); 
      match /details/{detailId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    }
    
    match /payrollRemittances/{remittanceId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /assets/{assetId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /equityTransactions/{transactionId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /companies/{companyId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /expenseCategories/{categoryId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /incomeCategories/{categoryId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /industries/{industryId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /loans/{loanId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /leads/{leadId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /projectTemplates/{templateId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /inventoryItems/{itemId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /inventoryLogs/{logId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /suppliers/{supplierId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /projects/{projectId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /tasks/{taskId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /ideas/{ideaId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /fileManagerFolders/{folderId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /files/{fileId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /crmActions/{actionId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /payrollWorkers/{workerId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    match /leaveRequests/{leaveRequestId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    
    match /timeLogs/{timeLogId} { 
      allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); 
      match /locations/{locationId} { allow read: if canReadOrgDoc(); allow create: if canCreateOrgDoc(); allow update: if canUpdateOrgDoc(); allow delete: if canDeleteOrgDoc(); }
    }

    // ---------------------------------------------------------
    // User Personal Preferences (No orgId needed)
    // ---------------------------------------------------------
    match /hytexerciseLogs/{logId} { 
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId; 
      allow read, update, delete: if isSignedIn() && request.auth.uid == resource.data.userId; 
    }
    match /userActionChips/{userId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    match /availableActionChips/{userId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    match /trashedActionChips/{userId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    match /accountingQuickNavItems/{userId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    match /availableAccountingNavItems/{userId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    match /hrQuickNavItems/{userId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    match /availableHrNavItems/{userId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    match /dialogSettings/{userId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    match /userAssistantChatSessions/{userId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    
    // ---------------------------------------------------------
    // Public/System collections
    // ---------------------------------------------------------
    match /siteImages/{imageId} {
      allow read: if true;
      allow write: if isOrgAdmin();
    }
    match /feedback/{feedbackId} {
      allow read: if isOrgAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isOrgAdmin();
    }
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read: if isOrgAdmin();
    }
  }
}